# Make browsers check for a newer copy of the game files on every visit (Declass build).
/declass/*
  Cache-Control: no-cache
/declass
  Cache-Control: no-cache
# Code Room tile photos (7 Nov 2026): each address carries a version tag that changes when the photo
# does, so phones may keep them for a year and a returning card shows instantly.
/declass/tiles/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
# Game sized card pictures (9 Nov 2026): versioned addresses, so phones keep them for a year.
/declass/cards/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
# The admin console (18 Nov 2026): always check for the newest copy.
/console/*
  Cache-Control: no-cache
/console
  Cache-Control: no-cache
